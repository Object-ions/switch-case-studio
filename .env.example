# ─── Google Analytics 4 ────────────────────────────────────────────────
# Copy this file to ".env" (which is git-ignored) and fill in your real
# Measurement ID. See GA4-SETUP.md for how to get it from Google.
#
# NOTE: Vite inlines these at BUILD time, and only variables prefixed with
# VITE_ are exposed to the app. After changing any value you must rebuild
# (npm run build) / redeploy.

# GA4 Measurement ID — looks like G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Optional: set to "true" to also send analytics from a local/dev build while
# testing (off by default so dev traffic doesn't pollute real reports).
# VITE_GA_DEBUG=true

# ─── EmailJS (contact form) ────────────────────────────────────────────
# Credentials from your EmailJS dashboard (https://dashboard.emailjs.com).
# Without these, the contact form submit will fail.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_USER_ID=
